{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "75 HARD",
  "version": "0.1.0",
  "identifier": "com.harrymendez.app75hard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Harry Mendez",
    "copyright": "Datos 100% locales. Sin cuentas, sin telemetría.",
    "category": "Productivity",
    "shortDescription": "Diario cuantificado de 75 días",
    "longDescription": "Tracker personal de hábitos para un reto de 75 días. Todo local, sin servidor y sin internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    }
  }
}
